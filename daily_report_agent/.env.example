# ============ LLM ============
# 默认 DeepSeek (OpenAI 兼容)。申请: https://platform.deepseek.com/
LLM_API_KEY=your_deepseek_api_key

# ============ 数据源 ============
# 美股新闻(免费额度够用)。申请: https://finnhub.io/
FINNHUB_KEY=your_finnhub_key
# A股用 akshare, 无需 key

# ============ 推送(按需填写, 只填你启用的渠道) ============
# --- 邮箱(SMTP) ---
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=you@qq.com
SMTP_PASSWORD=your_smtp_auth_code   # 邮箱的"授权码", 不是登录密码
SMTP_TO=you@qq.com                  # 收件人, 多个用逗号分隔

# --- Telegram ---
TELEGRAM_BOT_TOKEN=your_bot_token
TELEGRAM_CHAT_ID=your_chat_id

# --- 微信(Server酱) ---
# 申请: https://sct.ftqq.com/
SERVERCHAN_SENDKEY=your_sendkey
